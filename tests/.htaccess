# The test scripts in this folder are for the command line only.
#
# phase4-workflow-test.php writes to the database, so it must never be reachable
# over HTTP even if the portal is deployed by mistake. The scripts also refuse to
# run outside the CLI themselves; this file is the belt to that pair of braces.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
